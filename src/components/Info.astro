---
interface Props {
  title?: string;
  tagline?: string;
}

const { title = "Music XR", tagline = "Live music performances" } = Astro.props;
---

<section class="info section">
  <div class="container">
    <div class="info__content curved-card curved-card--accent">
      <p class="info__description">
        We take the performer out of the rig. Less cables, more movement.
        <br />
        Gesture control meets live sound for a fully immersive experience.
      </p>
    </div>
  </div>
</section>

<style>
  .info {
    padding: var(--space-lg) 0;
  }

  .info__content {
    position: relative;
    text-align: center;
    overflow: hidden;
    padding: var(--space-lg) var(--space-md);
  }

  .info__description {
    position: relative;
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.8;
  }

  @media (max-width: 600px) {
    .info__content {
      padding: var(--space-md) var(--space-sm);
    }
  }
</style>
