---
interface Props {
  title?: string;
  tagline?: string;
}

const { title = "summ0n", tagline = "minimalist. focused. crafted." } =
  Astro.props;
---

<section class="hero section">
  <div class="hero__image-wrapper" aria-hidden="true">
    <img src="/images/summ0n-performance.jpg" alt="" class="hero__image" />
    <div class="hero__overlay"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
    overflow: hidden;
    min-height: 35vh;
  }

  .hero__image-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
